# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# GitHub — dual-repo setup
# INPUT = private landing-zone repo the Azure Function writes to
# OUTPUT = public repo where this agent publishes polished issues
GITHUB_TOKEN=
GITHUB_INPUT_OWNER=data-altinn-no
GITHUB_INPUT_REPO=core-triage
GITHUB_OUTPUT_OWNER=data-altinn-no
GITHUB_OUTPUT_REPO=core
GITHUB_WEBHOOK_SECRET=
TRIAGE_LABEL=auto-triage
PUBLISHED_LABEL=auto-published

# Langfuse (optional tracing)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Server
HOST=0.0.0.0
PORT=8081
LOG_LEVEL=INFO

# Auto-fix pipeline (the core workflow: error → triage issue → PR).
# AUTOFIX_ENABLED is a runtime kill-switch so operators can suspend PR
# creation during incidents without a redeploy. It is `false` in this
# example file so a fresh checkout with no target repo configured doesn't
# try to push; set to `true` in your real .env / app settings.
AUTOFIX_ENABLED=false
AUTOFIX_TARGET_OWNER=data-altinn-no
AUTOFIX_TARGET_REPO=
AUTOFIX_BASE_BRANCH=main
AUTOFIX_TEST_CMD=pytest -q
AUTOFIX_LINT_CMD=
AUTOFIX_TEST_TIMEOUT_S=300
AUTOFIX_MAX_RETRIES=1
AUTOFIX_MAX_DIFF_LINES=200
AUTOFIX_WORKDIR=/tmp/log-triage-agent-ws
AUTOFIX_MIN_CONFIDENCE=0.5
AUTOFIX_BLOCK_LABEL=no-auto-fix
AUTOFIX_GIT_USER_NAME=log-triage-agent[bot]
AUTOFIX_GIT_USER_EMAIL=log-triage-agent@users.noreply.github.com
