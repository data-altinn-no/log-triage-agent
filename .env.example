# LLM provider: "azure_openai" or "azure_ai_foundry"
LLM_PROVIDER=azure_openai

# Azure OpenAI (used when LLM_PROVIDER=azure_openai)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Endpoint must end in /anthropic to route to the Messages API.
AZURE_AI_FOUNDRY_ENDPOINT=https://<your-resource>.services.ai.azure.com/anthropic
AZURE_AI_FOUNDRY_API_KEY=
# claude-opus-5 is stronger for the fix loop; sonnet-5 is the default.
AZURE_AI_FOUNDRY_MODEL=claude-sonnet-5

# INPUT = private repo the monitor writes to. OUTPUT = public repo.
GITHUB_TOKEN=
GITHUB_INPUT_OWNER=data-altinn-no
GITHUB_INPUT_REPO=log-triage
GITHUB_OUTPUT_OWNER=data-altinn-no
GITHUB_OUTPUT_REPO=core
GITHUB_WEBHOOK_SECRET=
TRIAGE_LABEL=auto-triage-errors,auto-triage-exceptions
PUBLISHED_LABEL=auto-published

# Langfuse (optional tracing)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Server
HOST=0.0.0.0
PORT=8081
LOG_LEVEL=INFO
# Local dev only: allows an unsigned webhook when no secret is set.
DEV_MODE=false

# AUTOFIX_ENABLED is a runtime kill-switch; false here so a fresh
# checkout with no target repo cannot push.
AUTOFIX_ENABLED=false
AUTOFIX_TARGET_OWNER=data-altinn-no
AUTOFIX_TARGET_REPO=
AUTOFIX_BASE_BRANCH=main
AUTOFIX_TEST_CMD=pytest -q
AUTOFIX_LINT_CMD=
AUTOFIX_TEST_TIMEOUT_S=300
AUTOFIX_MAX_RETRIES=1
AUTOFIX_MAX_DIFF_LINES=200
AUTOFIX_WORKDIR=/tmp/log-triage-agent-ws
AUTOFIX_MIN_CONFIDENCE=0.5
AUTOFIX_BLOCK_LABEL=no-auto-fix
AUTOFIX_GIT_USER_NAME=log-triage-agent[bot]
AUTOFIX_GIT_USER_EMAIL=log-triage-agent@users.noreply.github.com
