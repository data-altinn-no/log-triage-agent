// Sample App Insights query — pulls unique exception signatures over the last 5 minutes.
// Designed to run as a scheduled query alert. The Logic App receives one alert row per
// distinct (cloud_RoleName, problemId) pair, so frequent duplicates don't spam GitHub.
exceptions
| where timestamp > ago(5m)
| where cloud_RoleName startswith "data.altinn.no"
| summarize
    count_       = count(),
    anySample    = any(pack(
                        "type", type,
                        "message", outerMessage,
                        "details", tostring(details),
                        "operation", operation_Name,
                        "requestPath", tostring(customDimensions.RequestPath),
                        "correlationId", operation_Id,
                        "timestamp", timestamp
                   ))
    by cloud_RoleName, problemId
| project
    cloud_RoleName,
    problemId,
    count_,
    exceptionType = tostring(anySample.type),
    message       = tostring(anySample.message),
    stackTrace    = tostring(anySample.details),
    operation     = tostring(anySample.operation),
    requestPath   = tostring(anySample.requestPath),
    correlationId = tostring(anySample.correlationId),
    firstSeen     = todatetime(anySample.timestamp)
| order by count_ desc
